{
  "mark": "float-mixology-material",
  "version": 1,
  "material": {
    "id": "mix_mech_memory_capsule",
    "kind": "mechanism",
    "name": "剧情日志 · 逐轮自动摘要",
    "author": "独家特调",
    "hook": "每次生成自动归档本轮事件摘要，无痕静默剥离，带防误触确认弹窗，支持行内编辑与单轮删除",
    "tags": [
      "剧情日志",
      "逐轮摘要",
      "机括",
      "面板",
      "长记忆"
    ],
    "script": "function onBeforeSend(ctx) {\n  var store = ctx.store || {};\n  var list = [];\n  try {\n    list = JSON.parse(store.summaries || store.memories || \"[]\");\n  } catch (e) {\n    list = [];\n  }\n  if (!Array.isArray(list)) list = [];\n\n  var sections = [];\n  if (list.length > 0) {\n    var activeList = list.slice(-30);\n    var text = \"## 剧情历程与历史事件脉络（以下是按轮次真实发生过的关键历程，请牢记并保持性格、关系与记忆的连贯）：\\n\" +\n      activeList.map(function(item) {\n        var prefix = item.turn ? (\"- 第 \" + item.turn + \" 轮：\") : \"- \";\n        return prefix + item.text;\n      }).join(\"\\n\");\n    sections.push({ at: \"world\", text: text });\n  }\n\n  var currentTurn = (ctx.turnCount || 0) + 1;\n  var note = \"[系统协议：回复正文结束后，请必须在最末尾单起一行输出本轮互动的精炼事件摘要（15~30字，客观概括双方动作、核心话题与剧情推进），格式为：[摘要: 概述内容]。此行会被系统自动归档为第\" + currentTurn + \"轮日志，并从玩家聊天界面中完全抹除]\";\n\n  return {\n    sections: sections,\n    note: note,\n    store: store\n  };\n}\n\nfunction onRawReply(ctx) {\n  var raw = ctx.raw || \"\";\n  var store = ctx.store || {};\n  var list = [];\n  try {\n    list = JSON.parse(store.summaries || store.memories || \"[]\");\n  } catch (e) {\n    list = [];\n  }\n  if (!Array.isArray(list)) list = [];\n\n  var re = /\\[(?:本轮)?(?:摘要|总结|MEMO|LOG|记)\\s*[:：]\\s*([^\\]]+)\\]/gi;\n  var match;\n  var added = false;\n  while ((match = re.exec(raw)) !== null) {\n    var item = match[1].trim();\n    if (item) {\n      var d = new Date();\n      var timeStr = (d.getHours() < 10 ? \"0\" : \"\") + d.getHours() + \":\" + (d.getMinutes() < 10 ? \"0\" : \"\") + d.getMinutes();\n      list.push({\n        id: \"s_\" + Date.now() + \"_\" + Math.floor(Math.random() * 1000),\n        turn: ctx.turnCount || list.length + 1,\n        text: item,\n        time: timeStr\n      });\n      added = true;\n      break;\n    }\n  }\n\n  var cleanedRaw = raw.replace(re, \"\").trim();\n\n  if (list.length > 80) {\n    list = list.slice(list.length - 80);\n  }\n\n  if (added) {\n    store.summaries = JSON.stringify(list);\n    store.memories = store.summaries;\n  }\n\n  return {\n    raw: cleanedRaw,\n    store: store\n  };\n}",
    "layout": {
      "x": 6,
      "y": 15,
      "w": 88,
      "h": 55,
      "drag": true,
      "resize": true,
      "chrome": "bar",
      "plate": true,
      "collapsed": false
    },
    "panelHtml": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;\n    color: #f1f5f9;\n    padding: 10px;\n    font-size: 13px;\n    line-height: 1.5;\n    user-select: none;\n    background: transparent;\n  }\n  .capsule-app {\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    max-height: 100vh;\n  }\n  .header-bar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 10px;\n    padding-bottom: 6px;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n  }\n  .header-title {\n    font-size: 13px;\n    font-weight: 600;\n    color: #e2e8f0;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .count-badge {\n    background: rgba(16, 185, 129, 0.2);\n    color: #34d399;\n    border: 1px solid rgba(16, 185, 129, 0.35);\n    font-size: 11px;\n    padding: 1px 7px;\n    border-radius: 999px;\n  }\n  .clear-btn {\n    background: transparent;\n    border: none;\n    color: #94a3b8;\n    font-size: 11px;\n    cursor: pointer;\n    padding: 2px 6px;\n    border-radius: 4px;\n    transition: all 0.2s;\n  }\n  .clear-btn:hover {\n    color: #f87171;\n    background: rgba(239, 68, 68, 0.1);\n  }\n  .add-box {\n    display: flex;\n    gap: 6px;\n    margin-bottom: 10px;\n  }\n  .input-text {\n    flex: 1;\n    background: rgba(15, 23, 42, 0.65);\n    border: 1px solid rgba(255, 255, 255, 0.15);\n    color: #f8fafc;\n    border-radius: 6px;\n    padding: 6px 10px;\n    font-size: 12px;\n    outline: none;\n    transition: border 0.2s;\n  }\n  .input-text:focus {\n    border-color: #10b981;\n  }\n  .btn-primary {\n    background: #059669;\n    color: #fff;\n    border: none;\n    border-radius: 6px;\n    padding: 6px 12px;\n    font-size: 12px;\n    font-weight: 500;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: background 0.2s;\n  }\n  .btn-primary:hover {\n    background: #047857;\n  }\n  .list-container {\n    flex: 1;\n    overflow-y: auto;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    padding-right: 2px;\n  }\n  .list-container::-webkit-scrollbar {\n    width: 4px;\n  }\n  .list-container::-webkit-scrollbar-thumb {\n    background: rgba(255, 255, 255, 0.2);\n    border-radius: 4px;\n  }\n  .summary-card {\n    background: rgba(30, 41, 59, 0.55);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    border-radius: 8px;\n    padding: 8px 10px;\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n    transition: background 0.15s;\n    user-select: text;\n  }\n  .summary-card:hover {\n    background: rgba(30, 41, 59, 0.8);\n  }\n  .card-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n  .turn-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    font-size: 11px;\n    font-weight: 600;\n    color: #6ee7b7;\n    background: rgba(16, 185, 129, 0.15);\n    padding: 1px 6px;\n    border-radius: 4px;\n  }\n  .time-text {\n    font-size: 10px;\n    color: #64748b;\n  }\n  .card-main {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 8px;\n  }\n  .summary-content {\n    flex: 1;\n    word-break: break-word;\n    color: #e2e8f0;\n    font-size: 12px;\n    line-height: 1.5;\n  }\n  .card-actions {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    flex-shrink: 0;\n  }\n  .action-btn {\n    background: transparent;\n    border: none;\n    cursor: pointer;\n    padding: 2px 5px;\n    border-radius: 4px;\n    font-size: 12px;\n    color: #94a3b8;\n    transition: all 0.15s;\n  }\n  .action-btn:hover {\n    color: #f1f5f9;\n    background: rgba(255, 255, 255, 0.12);\n  }\n  .action-btn.del-btn:hover {\n    color: #f87171;\n    background: rgba(239, 68, 68, 0.15);\n  }\n  .edit-area {\n    width: 100%;\n    background: rgba(15, 23, 42, 0.85);\n    border: 1px solid #10b981;\n    color: #f8fafc;\n    border-radius: 6px;\n    padding: 6px 8px;\n    font-size: 12px;\n    line-height: 1.4;\n    resize: vertical;\n    min-height: 52px;\n    outline: none;\n  }\n  .edit-btns {\n    display: flex;\n    justify-content: flex-end;\n    gap: 6px;\n    margin-top: 4px;\n  }\n  .btn-sm {\n    padding: 3px 8px;\n    font-size: 11px;\n    border-radius: 4px;\n    cursor: pointer;\n    border: none;\n  }\n  .btn-save {\n    background: #10b981;\n    color: #fff;\n  }\n  .btn-save:hover {\n    background: #059669;\n  }\n  .btn-cancel {\n    background: rgba(255, 255, 255, 0.12);\n    color: #cbd5e1;\n  }\n  .btn-cancel:hover {\n    background: rgba(255, 255, 255, 0.2);\n  }\n  .empty-tip {\n    text-align: center;\n    color: #64748b;\n    padding: 24px 10px;\n    font-size: 12px;\n    line-height: 1.6;\n  }\n\n  /* 自定义防误触确认弹窗 */\n  .modal-overlay {\n    position: fixed;\n    top: 0; left: 0; right: 0; bottom: 0;\n    background: rgba(0, 0, 0, 0.75);\n    backdrop-filter: blur(4px);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 16px;\n    z-index: 1000;\n  }\n  .modal-box {\n    background: #1e293b;\n    border: 1px solid rgba(239, 68, 68, 0.4);\n    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6), 0 0 15px rgba(239, 68, 68, 0.2);\n    border-radius: 10px;\n    padding: 16px;\n    width: 100%;\n    max-width: 280px;\n    text-align: center;\n    animation: modalPop 0.15s ease-out;\n  }\n  @keyframes modalPop {\n    from { transform: scale(0.9); opacity: 0; }\n    to { transform: scale(1); opacity: 1; }\n  }\n  .modal-title {\n    font-size: 13px;\n    font-weight: 700;\n    color: #f87171;\n    margin-bottom: 6px;\n  }\n  .modal-desc {\n    font-size: 11px;\n    color: #94a3b8;\n    line-height: 1.5;\n    margin-bottom: 14px;\n  }\n  .modal-actions {\n    display: flex;\n    gap: 8px;\n    justify-content: center;\n  }\n  .modal-btn {\n    flex: 1;\n    padding: 6px 12px;\n    border-radius: 6px;\n    font-size: 12px;\n    font-weight: 500;\n    cursor: pointer;\n    border: none;\n    transition: background 0.15s;\n  }\n  .modal-cancel {\n    background: rgba(255, 255, 255, 0.12);\n    color: #cbd5e1;\n  }\n  .modal-cancel:hover {\n    background: rgba(255, 255, 255, 0.2);\n  }\n  .modal-confirm {\n    background: #ef4444;\n    color: #fff;\n  }\n  .modal-confirm:hover {\n    background: #dc2626;\n  }\n</style>\n</head>\n<body>\n<div class=\"capsule-app\">\n  <div class=\"header-bar\">\n    <div class=\"header-title\">\n      <span>📜 剧情历程 · 逐轮摘要</span>\n      <span class=\"count-badge\" id=\"countBadge\">0 轮</span>\n    </div>\n    <button class=\"clear-btn\" id=\"clearBtn\" title=\"清空全部摘要日志\">清空</button>\n  </div>\n\n  <div class=\"add-box\">\n    <input type=\"text\" class=\"input-text\" id=\"addInput\" placeholder=\"手动记录/补录剧情发展...\" />\n    <button class=\"btn-primary\" id=\"addBtn\">+ 记录</button>\n  </div>\n\n  <div class=\"list-container\" id=\"listContainer\"></div>\n</div>\n\n<!-- 自定义防误触弹窗 -->\n<div class=\"modal-overlay\" id=\"confirmModal\" style=\"display: none;\">\n  <div class=\"modal-box\">\n    <div class=\"modal-title\">⚠️ 确定清空全部记录？</div>\n    <div class=\"modal-desc\">此操作将清空当前对局所有轮次的剧情摘要，且无法撤销恢复。</div>\n    <div class=\"modal-actions\">\n      <button class=\"modal-btn modal-cancel\" id=\"modalCancelBtn\">取消</button>\n      <button class=\"modal-btn modal-confirm\" id=\"modalConfirmBtn\">确认清空</button>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  var editingId = null;\n\n  function getList() {\n    var store = window.MIX_STORE || {};\n    try {\n      var arr = JSON.parse(store.summaries || store.memories || \"[]\");\n      return Array.isArray(arr) ? arr : [];\n    } catch(e) {\n      return [];\n    }\n  }\n\n  function saveList(list) {\n    var store = window.MIX_STORE || {};\n    store.summaries = JSON.stringify(list);\n    store.memories = store.summaries;\n    window.MIX_STORE = store;\n    if (window.mix && typeof window.mix.setStore === \"function\") {\n      window.mix.setStore(store);\n    }\n    render();\n  }\n\n  function render() {\n    var list = getList();\n    var countBadge = document.getElementById(\"countBadge\");\n    var container = document.getElementById(\"listContainer\");\n\n    if (countBadge) countBadge.textContent = list.length + \" 轮\";\n    if (!container) return;\n\n    if (list.length === 0) {\n      container.innerHTML = '<div class=\"empty-tip\">故事才刚刚开篇。<br/>每次生成时 AI 都会自动在此沉淀本轮摘要，您也可以随时手动补充。</div>';\n      return;\n    }\n\n    var html = \"\";\n    for (var i = list.length - 1; i >= 0; i--) {\n      var item = list[i];\n      var isEditing = (item.id === editingId);\n\n      html += '<div class=\"summary-card\" data-id=\"' + item.id + '\">';\n      html += '  <div class=\"card-top\">';\n      html += '    <span class=\"turn-tag\">' + (item.turn ? ('第 ' + item.turn + ' 轮') : '剧情记录') + '</span>';\n      if (item.time) html += '    <span class=\"time-text\">' + item.time + '</span>';\n      html += '  </div>';\n\n      if (isEditing) {\n        html += '  <textarea class=\"edit-area\" id=\"editInput_' + item.id + '\">' + escapeHtml(item.text) + '</textarea>';\n        html += '  <div class=\"edit-btns\">';\n        html += '    <button class=\"btn-sm btn-cancel\" data-act=\"cancel\">取消</button>';\n        html += '    <button class=\"btn-sm btn-save\" data-act=\"save\" data-id=\"' + item.id + '\">保存</button>';\n        html += '  </div>';\n      } else {\n        html += '  <div class=\"card-main\">';\n        html += '    <div class=\"summary-content\">' + escapeHtml(item.text) + '</div>';\n        html += '    <div class=\"card-actions\">';\n        html += '      <button class=\"action-btn\" title=\"编辑修改此轮摘要\" data-act=\"edit\" data-id=\"' + item.id + '\">✏️</button>';\n        html += '      <button class=\"action-btn del-btn\" title=\"删除此轮摘要\" data-act=\"del\" data-id=\"' + item.id + '\">×</button>';\n        html += '    </div>';\n        html += '  </div>';\n      }\n      html += '</div>';\n    }\n    container.innerHTML = html;\n  }\n\n  function escapeHtml(str) {\n    return String(str || \"\")\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\");\n  }\n\n  function startEdit(id) {\n    editingId = id;\n    render();\n    setTimeout(function(){\n      var el = document.getElementById(\"editInput_\" + id);\n      if (el) { el.focus(); el.select(); }\n    }, 50);\n  }\n\n  function cancelEdit() {\n    editingId = null;\n    render();\n  }\n\n  function saveEdit(id) {\n    var el = document.getElementById(\"editInput_\" + id);\n    if (!el) return;\n    var newText = el.value.trim();\n    if (!newText) {\n      deleteItem(id);\n      return;\n    }\n    var list = getList();\n    for (var i = 0; i < list.length; i++) {\n      if (list[i].id === id) {\n        list[i].text = newText;\n        break;\n      }\n    }\n    editingId = null;\n    saveList(list);\n    if (window.mix && window.mix.toast) window.mix.toast(\"摘要已更新\");\n  }\n\n  function deleteItem(id) {\n    var list = getList();\n    var next = list.filter(function(x) { return x.id !== id; });\n    editingId = null;\n    saveList(next);\n    if (window.mix && window.mix.toast) window.mix.toast(\"已删除此轮摘要\");\n  }\n\n  function addItem() {\n    var input = document.getElementById(\"addInput\");\n    if (!input) return;\n    var text = input.value.trim();\n    if (!text) return;\n    var list = getList();\n    var d = new Date();\n    var timeStr = (d.getHours() < 10 ? \"0\" : \"\") + d.getHours() + \":\" + (d.getMinutes() < 10 ? \"0\" : \"\") + d.getMinutes();\n    list.push({\n      id: \"s_\" + Date.now() + \"_\" + Math.floor(Math.random() * 1000),\n      turn: list.length + 1,\n      text: text,\n      time: timeStr\n    });\n    input.value = \"\";\n    saveList(list);\n    if (window.mix && window.mix.toast) window.mix.toast(\"已添加新摘要\");\n  }\n\n  // 事件委托绑定\n  var listContainer = document.getElementById(\"listContainer\");\n  listContainer.addEventListener(\"click\", function(e) {\n    var btn = e.target.closest(\"[data-act]\");\n    if (!btn) return;\n    var act = btn.getAttribute(\"data-act\");\n    var id = btn.getAttribute(\"data-id\");\n    if (act === \"edit\") {\n      startEdit(id);\n    } else if (act === \"del\") {\n      deleteItem(id);\n    } else if (act === \"save\") {\n      saveEdit(id);\n    } else if (act === \"cancel\") {\n      cancelEdit();\n    }\n  });\n\n  document.getElementById(\"addBtn\").addEventListener(\"click\", addItem);\n  document.getElementById(\"addInput\").addEventListener(\"keydown\", function(e) {\n    if (e.key === \"Enter\") addItem();\n  });\n\n  // 自定义确认弹窗逻辑\n  var confirmModal = document.getElementById(\"confirmModal\");\n  var clearBtn = document.getElementById(\"clearBtn\");\n  var modalCancelBtn = document.getElementById(\"modalCancelBtn\");\n  var modalConfirmBtn = document.getElementById(\"modalConfirmBtn\");\n\n  clearBtn.addEventListener(\"click\", function() {\n    var list = getList();\n    if (list.length === 0) {\n      if (window.mix && window.mix.toast) window.mix.toast(\"当前暂无记录\");\n      return;\n    }\n    confirmModal.style.display = \"flex\";\n  });\n\n  modalCancelBtn.addEventListener(\"click\", function() {\n    confirmModal.style.display = \"none\";\n  });\n\n  confirmModal.addEventListener(\"click\", function(e) {\n    if (e.target === confirmModal) {\n      confirmModal.style.display = \"none\";\n    }\n  });\n\n  modalConfirmBtn.addEventListener(\"click\", function() {\n    confirmModal.style.display = \"none\";\n    editingId = null;\n    saveList([]);\n    if (window.mix && window.mix.toast) window.mix.toast(\"剧情日志已清空\");\n  });\n\n  window.onMixSync = function(state, store) {\n    window.MIX_STORE = store || {};\n    render();\n  };\n\n  // 初始渲染\n  render();\n})();\n</script>\n</body>\n</html>",
    "createdAt": 1789539900000,
    "updatedAt": 1789539900000
  }
}